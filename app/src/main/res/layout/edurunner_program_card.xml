<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="190dp" android:layout_margin="9dp"
 android:padding="20dp" android:orientation="vertical" android:gravity="center"
 android:background="@drawable/edurunner_card">
 <ImageView android:id="@+id/ProgramIcon" android:layout_width="82dp" android:layout_height="82dp" android:scaleType="fitCenter"/>
 <TextView android:id="@+id/ProgramTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
  android:gravity="center" android:maxLines="1" android:ellipsize="end"
  android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="19sp" android:layout_marginTop="13dp"/>
 <TextView android:id="@+id/ProgramSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content"
  android:gravity="center" android:text="Запустить" android:textColor="#7F8DAA" android:textSize="13sp" android:layout_marginTop="3dp"/>
</LinearLayout>