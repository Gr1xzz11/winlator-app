<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
 android:padding="24dp" android:background="#090E1A">
 <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Программы"
  android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="30sp"/>
 <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Нажмите на программу для запуска"
  android:textColor="#9AA8C7" android:textSize="16sp" android:layout_marginTop="4dp" android:layout_marginBottom="20dp"/>
 <TextView android:id="@+id/EmptyPrograms" android:layout_width="match_parent" android:layout_height="0dp"
  android:layout_weight="1" android:gravity="center" android:text="Программ пока нет\nДобавьте shortcut в режиме разработчика"
  android:textColor="#9AA8C7" android:textSize="18sp"/>
 <androidx.recyclerview.widget.RecyclerView android:id="@+id/ProgramGrid" android:layout_width="match_parent"
  android:layout_height="0dp" android:layout_weight="1"/>
</LinearLayout>